/* =========================================
   RESET BÁSICO E VARIÁVEIS
   Aqui ficam as cores, fontes e medidas que se repetem pelo site,
   guardadas em variáveis para facilitar mudanças futuras.
========================================= */
:root {
  --cor-primaria: #ce5c5c;        /* Cor principal, usada em botões, links e destaques */
  --cor-primaria-escura: #a34646; /* Versão mais escura da cor principal, usada em hover e títulos */
  --cor-secundaria: #f6e9ee;      /* Cor de apoio, tom mais suave */
  --cor-texto: #2f2a2d;           /* Cor padrão dos textos */
  --cor-texto-claro: #6c6468;     /* Cor mais suave, usada em textos secundários */
  --cor-fundo: #fff7f7;           /* Cor de fundo geral da página */
  --cor-borda: #ffcaca;           /* Cor usada em bordas de campos, cartões e tabelas */
  --cor-erro: #c62828;            /* Cor usada para indicar campos inválidos */
  --cor-sucesso: #1e6335;         /* Cor usada na mensagem de confirmação de envio */
  --fonte-titulo: "Georgia", "Times New Roman", serif;      /* Fonte usada nos títulos */
  --fonte-texto: "Segoe UI", Arial, Helvetica, sans-serif;  /* Fonte usada nos textos comuns */
  --raio: 10px;                    /* Arredondamento padrão de cantos (botões, cartões, etc.) */
  --sombra: 0 4px 14px rgba(0, 0, 0, 0.08); /* Sombra suave usada em cartões e formulário */
}

/* Remove margens e espaçamentos padrão do navegador, para começar do zero */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box; /* Faz o tamanho de bordas e espaçamentos internos não somarem à largura definida */
}

/* Faz a rolagem até âncoras (como o #confirmacao) acontecer de forma suave, e não abrupta */
html {
  scroll-behavior: smooth;
}

/* Estilo base aplicado a todo o corpo da página */
body {
  font-family: var(--fonte-texto);
  color: var(--cor-texto);
  background-color: var(--cor-fundo);
  line-height: 1.6; /* Espaçamento entre linhas, para melhorar a leitura */
}

/* Estilo padrão para todos os títulos do site */
h1, h2, h3 {
  font-family: var(--fonte-titulo);
  color: var(--cor-primaria-escura);
  line-height: 1.25;
}

h1 { font-size: 30px; margin-bottom: 1rem; margin-top: 1rem;}
h2 { font-size: 30px; margin-bottom: 1rem; margin-top: 1rem;}
h3 { font-size: 30px; margin-bottom: 1rem; margin-top: 1rem;}

p { font-size: 20px; margin-bottom: 1rem; margin-top: 1rem;}

/* Estilo padrão dos links */
a {
  color: var(--cor-primaria);
  text-decoration: none;
}

a:hover, a:focus {
  text-decoration: underline;
}

/* Evita que imagens ultrapassem o tamanho do elemento que as contém */
img { max-width: 100%; display: block; }

/* Centraliza o conteúdo e limita a largura máxima, para não esticar demais em telas grandes */
.container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 1.25rem;
}

/* 
  Esconde o elemento visualmente, mas mantém acessível para leitores de tela.
  Usado, por exemplo, no título oculto do formulário.
*/
.sr-only {
  position: absolute;
  width: 1px; height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

/* =========================================
   BOTÕES
   Estilo aplicado aos botões e links com aparência de botão (como "Agendar agora").
========================================= */
.btn {
  display: inline-block;
  padding: 0.75rem 1.5rem;
  border-radius: var(--raio);
  font-weight: 600;
  border: none;
  cursor: pointer;
  transition: background-color 0.2s ease, transform 0.15s ease; /* Suaviza a mudança de cor e o leve movimento ao passar o mouse */
  font-size: 25px;
}

.btn-primary {
  background-color: var(--cor-primaria);
  color: #fff;
}

/* Ao passar o mouse ou focar no botão, ele escurece um pouco e sobe levemente */
.btn-primary:hover, .btn-primary:focus {
  background-color: var(--cor-primaria-escura);
  text-decoration: none;
  transform: translateY(-1px);
}

/* =========================================
   CABEÇALHO / NAVEGAÇÃO
   Estilo do topo da página, com logo e menu de navegação.
========================================= */
.site-header {
  background-image: linear-gradient(to bottom, #ff9898, #ffb8b8); /* Fundo em degradê suave */
  border-bottom: 1px solid var(--cor-borda);
}

.header-inner {
  display: flex;
  flex-direction: column; /* Empilha logo e menu */
  align-items: center;    /* Centraliza horizontalmente */
}

.logo {
  margin: 0 auto;
}

.logo img {
  width: 650px;    /* Define a largura da logo */
  height: auto;    /* Ajusta a altura automaticamente, preservando a proporção da imagem original */
  display: block;
}

/* Remove marcadores da lista e organiza os itens do menu lado a lado */
.main-nav ul {
  list-style: none;
  display: flex;
  gap: 1.75rem;
}

.main-nav a {
  color: var(--cor-texto);
  font-weight: 500;
  font-size: 25px;
  padding: 0.25rem 0;
  border-bottom: 2px solid transparent; /* Espaço reservado para a linha que aparece no hover/página ativa */
}

/* Destaca o link da página em que a pessoa está, ou ao passar o mouse */
.main-nav a:hover,
.main-nav a[aria-current="page"] {
  color: var(--cor-primaria);
  border-bottom-color: var(--cor-primaria);
  text-decoration: none;
}

/* Esconde visualmente a checkbox usada no menu mobile, mas mantém funcional */
.menu-toggle-input {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

/* Mostra um contorno de foco no ícone do menu, quando a checkbox é acessada via teclado */
.menu-toggle-input:focus-visible ~ .menu-toggle {
  outline: 2px solid var(--cor-primaria-escura);
  outline-offset: 2px;
}

/* Ícone do menu "sanduíche" (três linhas), escondido por padrão e exibido só em telas pequenas */
.menu-toggle {
  display: none;
  flex-direction: column;
  justify-content: space-between;
  width: 28px;
  height: 20px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
}

.menu-toggle span {
  display: block;
  height: 3px;
  width: 100%;
  background-color: var(--cor-primaria-escura);
  border-radius: 2px;
}

/* =========================================
   HERO
   Seção de destaque logo no início da página inicial.
========================================= */
.hero {
  background-color: #ffdbdb;
  padding: 5rem 0;
  text-align: center;
  color: #402520;
}

.hero p {
  max-width: 560px;
  margin: 0 auto 1.5rem;
}

/* =========================================
   SEÇÕES GERAIS
   Espaçamento padrão aplicado a todas as seções do conteúdo principal.
========================================= */
main section {
  padding: 3rem 0;
}

.page-intro {
  padding-bottom: 1.5rem;
}

.page-intro p {
  color: #402520;
}

/* =========================================
   CARDS
   Estilo dos cartões usados para exibir destaques e serviços.
========================================= */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr); /* Três colunas iguais lado a lado */
  gap: 1.5rem;
}

.card {
  background-color: #ffe9e9;
  border: 1px solid var(--cor-borda);
  border-radius: var(--raio);
  padding: 1.5rem;
  box-shadow: var(--sombra);
}

.servico .preco {
  font-weight: 700;
  color: var(--cor-primaria-escura);
  margin-top: 0.5rem;
}

.cta-box {
  text-align: center;
  margin-top: 2.5rem;
}

.cta-box p {
  color: #402520;
}

/* =========================================
   TABELA DE HORÁRIOS
   Estilo da tabela exibida na página inicial, com os dias e horários de funcionamento.
========================================= */
.tabela-horarios {
  width: 60%;
  margin: 0 auto;
  border-collapse: collapse; /* Une as bordas das células, evitando espaçamento duplo entre elas */
  background-color: #fffbfb;
  box-shadow: var(--sombra);
  border-radius: var(--raio);
  overflow: hidden; /* Garante que o arredondamento das bordas também recorte o conteúdo interno */
}

.tabela-horarios caption {
  text-align: left;
  padding: 0.75rem 1rem;
  font-weight: bold;
  background-color: #ffcbcb;
  font-size: 25px;
  color: #402520;
}

.tabela-horarios thead th {
  font-weight: bold;
  background-color: #ffe0e0;
  color: #402520;
  font-size: 20px;
}

.tabela-horarios tbody th {
  font-weight: normal;
  color: #402520;
  font-size: 20px;
}

.tabela-horarios td {
  font-weight: normal;
  padding: 0.75rem 1rem;
  text-align: center;
  color: #402520;
  font-size: 20px;
}

/* Alterna a cor de fundo das linhas ímpares, facilitando a leitura da tabela */
.tabela-horarios tbody tr:nth-child(odd) {
  background-color: #fff5f5;
}

/* =========================================
   FORMULÁRIO
   Estilo aplicado ao formulário de agendamento e seus campos.
========================================= */
.form-section form {
  max-width: 640px;
  margin: 0 auto;
  background-color: #fff;
  border: 1px solid var(--cor-borda);
  border-radius: var(--raio);
  padding: 2rem;
  box-shadow: var(--sombra);
}

.form-group {
  margin-bottom: 1.25rem;
  display: flex;
  flex-direction: column; /* Coloca o rótulo em cima e o campo embaixo */
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr; /* Duas colunas iguais, usadas para "Data" e "Horário" lado a lado */
  gap: 1rem;
}

label {
  font-weight: 600;
  margin-bottom: 0.35rem;
  font-size: 25px;
}

input, select, textarea {
  padding: 0.65rem 0.75rem;
  border: 1px solid var(--cor-borda);
  border-radius: 6px;
  font-family: inherit;
  font-size: 20px;
  background-color: #fff;
  color: var(--cor-texto);
}

/* Destaca o campo em uso, com uma borda e um brilho suave ao redor */
input:focus, select:focus, textarea:focus {
  outline: none;
  border-color: var(--cor-primaria);
  box-shadow: 0 0 0 3px rgba(184, 73, 122, 0.15);
}

/* Deixa a borda vermelha quando o campo é preenchido de forma inválida */
input:invalid:not(:placeholder-shown), select:invalid, textarea:invalid:not(:placeholder-shown) {
  border-color: var(--cor-erro);
}

.aviso-horario {
  font-size: 0.85rem;
  color: var(--cor-texto-claro);
  margin-top: -0.5rem;
  margin-bottom: 1.25rem;
}

/* =========================================
   RODAPÉ
   Estilo da faixa final da página, presente em todo o site.
========================================= */
.site-footer {
  background-color: var(--cor-primaria-escura);
  color: #fff;
  padding: 1.75rem 0;
  margin-top: 2rem;
  text-align: center;
}

.site-footer p {
  margin-bottom: 0.25rem;
  font-size: 20px;
  opacity: 0.9;
}

/* =========================================
   RESPONSIVIDADE
   Ajustes aplicados conforme o tamanho da tela diminui, para telas 
   de tablets e celulares.
========================================= */

/* Telas médias: cartões passam de 3 para 2 colunas */
@media (max-width: 900px) {
  .cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Telas pequenas: ativa o menu mobile e reorganiza o layout em coluna única */
@media (max-width: 700px) {
  .menu-toggle {
    display: flex; /* Mostra o ícone do menu sanduíche */
  }

  .main-nav {
    margin-left: auto;
    position: static;
    width: 100%;
    max-height: 0;    /* Menu começa "fechado" (sem altura) */
    overflow: hidden;
    transition: max-height 0.3s ease; /* Suaviza a abertura e o fechamento do menu */
  }

  /* Quando a checkbox do menu está marcada, o menu ganha altura e aparece */
  .menu-toggle-input:checked ~ .main-nav {
    max-height: 300px;
  }

  .main-nav ul {
    flex-direction: column; /* Itens do menu empilhados, um abaixo do outro */
    gap: 0;
    padding: 0.5rem 1.25rem 1rem;
  }

  .main-nav li {
    border-bottom: 1px solid var(--cor-borda);
  }

  .main-nav li:last-child {
    border-bottom: none;
  }

  .main-nav a {
    display: block;
    padding: 0.75rem 0;
  }

  .hero h1 { font-size: 1.8rem; }

  .cards-grid {
    grid-template-columns: 1fr; /* Uma única coluna em telas pequenas */
  }

  .form-row {
    grid-template-columns: 1fr; /* "Data" e "Horário" passam a ficar um embaixo do outro */
  }

  .form-section form {
    padding: 1.25rem;
  }

  .logo img {
    width: 100%;
    max-width: 320px; /* Evita que a logo fique grande demais em telas pequenas */
  }
}

/* Telas bem pequenas: reduz ainda mais o tamanho do título e o espaçamento do hero */
@media (max-width: 420px) {
  h1 { font-size: 1.6rem; }
  .hero { padding: 2.5rem 0; }
}